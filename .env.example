# ==============================================================================
# LLM Provider API Keys
# ==============================================================================
# Gemini API Key (for Google AI Studio / smolagents models)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Key (for multi-provider LLM models like GLM, Claude, DeepSeek, etc.)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ==============================================================================
# Google Calendar API Configuration (OAuth 2.0)
# ==============================================================================
# Path to your Google Cloud OAuth Client Secret JSON file
GOOGLE_CREDENTIALS_FILE=credentials.json

# Path where the generated OAuth refresh token will be stored
GOOGLE_TOKEN_FILE=token.json

# Google Calendar ID to sync and check for bookings ("primary" default)
GOOGLE_CALENDAR_ID=primary

# ==============================================================================
# Lead Qualification & Outreach Configuration
# ==============================================================================
# Minimum qualification score (0-100) required to send a connection request
LEAD_SCORE_THRESHOLD=70

# Grace period in hours before scheduling an automated follow-up
FOLLOWUP_GRACE_HOURS=48

# Your Google Calendar / Calendly appointment scheduling URL
CALENDAR_BOOKING_URL=https://calendar.app.google/your_booking_link_here

# ==============================================================================
# Founder Email Alert Configuration (SMTP)
# ==============================================================================
# Recipient email address for real-time lead alerts
ALERT_EMAIL_TO=founder@example.com

# Sender email address
ALERT_EMAIL_FROM=founder@example.com

# SMTP Server Host (e.g. smtp.gmail.com, smtp.mailgun.org)
SMTP_HOST=smtp.gmail.com

# SMTP Port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# SMTP Username / Authentication email
SMTP_USER=founder@example.com

# SMTP Password or App Password (for Gmail, generate an App Password)
SMTP_PASS=your_app_password_here
