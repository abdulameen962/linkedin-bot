{
   "action": {
      "default_popup": "popup.html"
   },
   "background": {
      "service_worker": "background.js"
   },
   "default_locale": "en",
   "description": "DevTools RPC Bridge for Ascentrader AI Agent",
   "host_permissions": [ "<all_urls>" ],
   "icons": {
      "128": "icon/128.png",
      "16": "icon/16.png",
      "32": "icon/32.png",
      "48": "icon/48.png"
   },
   "manifest_version": 3,
   "name": "Ascentrader WebBridge",
   "permissions": [ "tabs", "activeTab", "debugger", "storage", "alarms", "tabGroups", "windows", "scripting" ],
   "version": "1.0.0"
}
